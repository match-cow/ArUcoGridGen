              "marker_size_mm": 30.0,
              "rows": 7,
              "separation_mm": 10.0,
              "show_ids": true,
              "type": "aruco"
            },
            "discriminator": {
              "mapping": {
                "aruco": "#/components/schemas/ArucoBoard",
                "charuco": "#/components/schemas/CharucoBoard",
                "checkerboard": "#/components/schemas/Checkerboard"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/ArucoBoard"
              },
              {
                "$ref": "#/components/schemas/CharucoBoard"
              },
              {
                "$ref": "#/components/schemas/Checkerboard"
              }
            ],
            "title": "Board"
          },
          "coordinate_frame": {
            "$ref": "#/components/schemas/CoordinateFrame",
            "default": {
              "enabled": false,
              "pose": {
                "pitch_deg": 0.0,
                "roll_deg": 0.0,
                "translation_x_m": 0.0,
                "translation_y_m": 0.0,
                "translation_z_m": 0.0,
                "yaw_deg": 0.0
              }
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page",
            "default": {
              "orientation": "portrait",
              "paper_size": "A4"
            }
          },
          "print_compensation": {
            "$ref": "#/components/schemas/PrintCompensation",
            "default": {
              "x_percent": 100.0,
              "y_percent": 100.0
            }
          },
          "schema_version": {
            "const": "2.0",
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "title": "GenerateRequest",
        "type": "object"
      },
